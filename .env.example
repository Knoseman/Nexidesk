# ─── Branding (optional — Nexi Group defaults ship out-of-the-box) ──────────
# To white-label for another tenant, set these in Railway and redeploy.
# The favicon is generated dynamically from BRAND_PRIMARY + first letter of BRAND_NAME.
# The wordmark is served from /public — replace nexi-logo.png or point BRAND_LOGO_URL
# at a different path/URL, and set BRAND_LOGO_RATIO to the image's width÷height.
#
# NEXT_PUBLIC_BRAND_NAME=Nexi Group
# NEXT_PUBLIC_BRAND_TAGLINE=The European PayTech
# NEXT_PUBLIC_BRAND_PRIMARY=#2D32AA
# NEXT_PUBLIC_BRAND_PRIMARY_FG=#ffffff
# NEXT_PUBLIC_BRAND_SIDEBAR=#0f172a
# NEXT_PUBLIC_BRAND_SIDEBAR_FG=#f8fafc
# NEXT_PUBLIC_BRAND_ACCENT=#2D32AA
# NEXT_PUBLIC_BRAND_LOGO_URL=/nexi-logo.png
# NEXT_PUBLIC_BRAND_LOGO_RATIO=3.062
# NEXT_PUBLIC_BRAND_FAVICON_URL=               # override favicon; if unset, src/app/favicon.ico + icon.png are used

# Neon Postgres (EU Frankfurt)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/nexidesk?sslmode=require

# NextAuth.js v5
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://nexidesk.up.railway.app

# Microsoft Entra ID (same app registration for SSO and IMAP/Graph)
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
# Optional: verified domain for Entra UPNs when creating users via /api/register.
# If omitted, the agent's email domain is used (must be verified in your tenant).
# AZURE_AD_UPN_DOMAIN=yourtenant.onmicrosoft.com

# IMAP inbound (M2) — delegated XOAUTH2 for shared mailbox
IMAP_HOST=outlook.office365.com
IMAP_USER=shared@org.com
IMAP_OAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Same as AZURE_AD_TENANT_ID for work/school only; use `common` for @outlook.com personal mailbox
# IMAP_OAUTH_AUTHORITY=common
IMAP_OAUTH_REFRESH_TOKEN=your-imap-refresh-token

# Graph outbound (M4) — delegated Mail.Send for shared mailbox (saveToSentItems: false in app)
# Refresh token: pnpm graph:token (scripts/get-graph-token.mjs) — separate from IMAP token (Entra AADSTS70011)
GRAPH_MAILBOX_USER=shared@org.com
# Optional: consumer @outlook.com mailboxes may expose outlook_*@outlook.com; set to your real alias for From:
# GRAPH_MAILBOX_FROM=shared@org.com
# GRAPH_MAILBOX_FROM_NAME=Support
GRAPH_OAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_OAUTH_REFRESH_TOKEN=your-graph-refresh-token
# Optional; defaults to IMAP_OAUTH_AUTHORITY / AZURE_AD_TENANT_ID
# GRAPH_OAUTH_AUTHORITY=common

# Cloudflare R2 attachment storage (M6) — EU bucket
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=nexidesk-attachments-eu
